# ---------- Core ----------
PORT=8787
PUBLIC_BASE_URL=http://localhost:8787          # set to your tunnel URL (pnpm tunnel) when connecting ElevenLabs
DASHBOARD_URL=http://localhost:3000
DATA_STORE=memory                               # memory | dynamo (Phase 4)
DEMO_MODE=true
INTERNAL_TOKEN=change-me-internal
MCP_AGENT_TOKEN=change-me-agent                 # ElevenLabs sends this as "Authorization: Bearer ..."
FAMILY_TOKEN_DEMO=change-me-family              # dashboard + (Phase 2) Claude family connector
DEMO_ELDER_PHONE=                               # E.164, the phone that plays "Amma" (Phase 1)

# ---------- ElevenLabs (Phase 1 for phone calls; Phase 0 uses the browser test call) ----------
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
ELEVENLABS_WEBHOOK_SECRET=
ELEVENLABS_API_BASE=https://api.elevenlabs.io      # India residency: https://api.in.residency.elevenlabs.io (if your plan allows)
ELEVENLABS_BRIEFING_AGENT_ID=                   # kaiseho-briefing (calls the son / neighbour in emergencies)
ELEVENLABS_CLINIC_AGENT_ID=                     # kaiseho-clinic (books doctor appointments; set by pnpm setup:elevenlabs)
CLINIC_MCP_TOKEN=change-me-clinic                # the clinic agent's own MCP door
DEMO_CLINIC_PHONE=                              # E.164, a teammate playing the clinic receptionist
ELEVENLABS_DIGEST_VOICE_ID=                     # same voice as the agent, for the weekly audio digest
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
DIGEST_AUDIO=false                              # true = digest MP3 via ElevenLabs TTS (uses credits)

# ---------- Twilio (pnpm setup:twilio does the rest) ----------
TWILIO_ACCOUNT_SID=                             # Console home → Account Info (starts with AC)
TWILIO_AUTH_TOKEN=                              # Console home → Account Info → Auth Token (click to reveal)
TWILIO_PHONE_NUMBER=                            # filled in by the script

# ---------- LLM (post-call insights, starters, digest script, scam layer 2) ----------
LLM_PROVIDER=none                               # none (rules) | anthropic | bedrock
LLM_MODEL=
LLM_VISION_MODEL=                               # prescription photos (defaults to LLM_MODEL)
ANTHROPIC_API_KEY=

# ---------- Telegram ----------
TELEGRAM_BOT_TOKEN=                             # from @BotFather
TELEGRAM_DEMO_CHAT_ID=                          # your chat id; receives the primary child's (Ravi's) alerts
TELEGRAM_WEBHOOK_SECRET=change-me-telegram       # webhook path secret; then POST /internal/telegram/set-webhook

# ---------- AWS (Phase 4; see docs/aws-runbook.md) ----------
AWS_REGION=ap-south-1
DDB_TABLE=kaiseho_main
S3_BUCKET=
SCHEDULER=local                                 # local | eventbridge
SCHEDULER_GROUP=kaiseho
SCHEDULER_ROLE_ARN=
JOB_RUNNER_LAMBDA_ARN=
BEDROCK_MODEL_ID=                               # with LLM_PROVIDER=bedrock

# ---------- Privacy / tuning ----------
TRANSCRIPT_RETENTION_HOURS=24
RETRY_MINUTES=15                                # demo: 1
ENABLE_DAILY_CALLS=false                        # true = place daily calls + Sunday digests on schedule
DIGEST_DAY=0                                    # 0 = Sunday
DIGEST_TIME=20:00
DATA_DIR=.data                                  # local digest MP3s (S3 in Phase 4)
TIMEZONE_DEFAULT=Asia/Kolkata
